    "diagnose-catalog": "node scripts/diagnoseCatalog.js",
    "diagnose-pharmacies": "node scripts/diagnosePharmacies.js",
    "diagnose-rag": "node scripts/diagnoseRag.js",
    "diagnose-llm": "node scripts/diagnoseLlm.js",
