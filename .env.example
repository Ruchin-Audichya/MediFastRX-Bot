# ── Required for the live Telegram bot (Demo Studio works without any of these) ──
TELEGRAM_BOT_TOKEN=            # from @BotFather
ADMIN_TELEGRAM_IDS=            # comma-separated numeric Telegram user ids (ask @userinfobot)

# ── Public deployment ──
PUBLIC_URL=                    # e.g. https://medifast-demo.fly.dev  (https enables webhook + Mini App)
TELEGRAM_WEBHOOK_SECRET=       # any long random string; webhook mode is used when this and an https PUBLIC_URL are set
TELEGRAM_MODE=auto             # auto | polling | webhook | off

# ── Optional ──
ANTHROPIC_API_KEY=             # enables Claude vision for handwritten prescriptions (local OCR otherwise)
DEMO_MODE=true                 # seeds the fictional Jaipur network + Demo Studio
DEMO_SPEED=1                   # <1 makes simulated pharmacies answer faster
DATABASE_PATH=var/medifast.db
PORT=3000
