# Telegram
TELEGRAM_BOT_TOKEN=your_token_from_botfather

# MongoDB
MONGODB_URI=mongodb://localhost:27017/medifast
PORT=3001

# Groq / LLM synthesis
AI_PROVIDER=deterministic
LLM_PROVIDER=groq
ENABLE_LLM_SYNTHESIS=true
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_MS=4500
GROQ_TEMPERATURE=0.15
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3

# RAG / Vector store
VECTOR_DB=chroma
VECTOR_MODE=local
CHROMA_URL=http://localhost:8000
CHROMA_LOCAL_PATH=./data/chroma
CHROMA_KNOWLEDGE_COLLECTION=medifast_knowledge
CHROMA_MEMORY_COLLECTION=medifast_memory
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RETRIEVAL_SEMANTIC_WEIGHT=0.55
RETRIEVAL_KEYWORD_WEIGHT=0.35
RETRIEVAL_CATEGORY_WEIGHT=0.10
RETRIEVAL_CONFIDENCE_THRESHOLD=0.40

# Medicine catalog
ENABLE_LIVE_INVENTORY_SEARCH=false
MEDICINE_KNOWLEDGE_CONFIDENCE_THRESHOLD=0.55
LIVE_MEDICINE_SEMANTIC_MATCHING=false
ENABLE_SLOW_SEMANTIC_MATCHING=false
ENABLE_FULL_MEDICINE_INDEX=false
MEDICINE_IMPORT_BATCH_SIZE=1000
MEDICINE_KNOWLEDGE_INDEX_LIMIT=300000
MEDICINE_TEXT_CANDIDATE_LIMIT=25
MEDICINE_MATCHER_FUZZY_CANDIDATE_LIMIT=500
MEDICINE_KNOWLEDGE_RAG_BATCH_SIZE=500
MEDICINE_KNOWLEDGE_RAG_MAX_RECORDS=0
MEDICINE_KNOWLEDGE_RAG_INCREMENTAL_HOURS=0
MEDICINE_KNOWLEDGE_RAG_RESUME=true
MEDICINE_RAG_PRIORITY_TERMS=dolo,dolo 650,paracetamol,crocin,pregabalin,alprax,pantoprazole
MEDICINE_ENRICHMENT_LIMIT=5000
DUPLICATE_CLEANUP_APPLY=false
DUPLICATE_CLEANUP_GROUP_LIMIT=250

# Side-effect enrichment
SIDE_EFFECTS_AUTO_MERGE_CONFIDENCE=0.8
SIDE_EFFECTS_UNMATCHED_CONFIDENCE=0.5
SIDE_EFFECTS_FUZZY_MATCHING=false
SIDE_EFFECTS_SEMANTIC_MATCHING=false

# Pharmacy / Nearby discovery
NEARBY_RADIUS_KM=5
NEARBY_MAX_RADIUS_KM=10
NEARBY_MIN_RESULTS=3
PHARMACY_IMPORT_CITY=Jaipur
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_LIVE_LOOKUP=true
OSM_LIVE_RADIUS_KM=8
OSM_TIMEOUT_MS=8000
OSM_RETRIES=1

# Analytics
RUNTIME_TRACE_TELEGRAM_ID=runtime
DEAD_CODE_WARNING_LIMIT=25

# Debug
AI_DEBUG=false
NODE_ENV=development

# MediAtlas integration (handshake locked, Sprint 1)
# Off by default. Flip to true when /openapi.json goes green and the API key
# has been imported from MediAtlas/.local/medifast_keys.txt into the secret
# store. The MediAtlas client returns {ok:false, disabled:true} when this is
# not "true", so production behavior does not shift while the flag is off.
ENABLE_MEDIATLAS=false
MEDIATLAS_BASE_URL=http://localhost:8000
MEDIATLAS_API_KEY=
MEDIATLAS_TIMEOUT_MS=3000
# Webhook receiver shared secret (set after POST /api/v1/webhooks/register;
# MediAtlas generates the secret server-side and returns it in the response).
MEDIATLAS_WEBHOOK_SECRET=
