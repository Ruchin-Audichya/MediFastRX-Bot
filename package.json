{
  "name": "medifast-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Medicine confusion, sorted. A local medicine reference and pharmacy finder.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:all": "node scripts/dev.cjs --telegram",
    "bot": "node src/telegram/run.cjs",
    "bot:check": "node src/telegram/run.cjs --check",
    "bot:webhook": "node scripts/telegram-webhook.cjs",
    "bot:demo": "node scripts/telegram-demo.cjs",
    "start": "node scripts/dev.cjs --production",
    "build": "next build",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run build",
    "catalog:import": "node scripts/import-catalog.cjs",
    "measure": "node scripts/measure.cjs",
    "typecheck": "tsc --noEmit",
    "demo:reset": "node scripts/seed-platform.cjs --reset",
    "seed": "node scripts/seed-platform.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "grammy": "^1.46.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "next": "^16.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
