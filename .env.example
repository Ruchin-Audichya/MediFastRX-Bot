# No credentials required. Demo partners and their stock are fictional.
APP_MODE=demo
API_PORT=3101
WEB_PORT=3000
HOST=127.0.0.1
# live: public Photon/OSM listings + dated Jaipur directory; stock always unknown.
# demo: clearly fictional nearby listings, useful offline.
PHARMACY_MODE=live
# Optional SQLite path; defaults to .local/catalog.sqlite
# CATALOG_FILE=.local/catalog.sqlite
# Required for a live HTTPS deployment; use the exact browser origin.
# APP_ORIGIN=https://your-domain.example
# Optional evidence selection. No key = deterministic catalog explanation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Telegram adapter. Web mode still starts without it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# Optional public HTTPS frontend address for exact-product / scanner links.
TELEGRAM_APP_URL=
# Webhook deployments only; polling does not need either value.
# TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=
