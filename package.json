{
  "name": "medifast",
  "version": "3.0.0",
  "private": true,
  "description": "Ask every chemist nearby, at once. A Telegram-first medicine availability network.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node src/scripts/dev.mjs",
    "start": "node src/main.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test --test-reporter=spec tests/*.test.ts",
    "seed:reset": "node src/scripts/reset.ts",
    "bot:check": "node src/scripts/bot-check.ts",
    "evaluate": "node src/scripts/evaluate.ts",
    "demo": "node launcher/launch.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "grammy": "^1.46.0",
    "helmet": "^8.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
